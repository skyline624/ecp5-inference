# ---- build artifacts (regenerable : yosys / nextpnr / ecppack / iverilog) ----
# Extensions d'artefacts (s'applique partout, y compris dans build/ et sim/).
# Les scripts build.ps1 / build.sh / install_toolchain.ps1 / scaffold.ps1 /
# synth.ys et sim/Makefile sont des sources et ne matchent pas ces patterns.
*.bit
*.bin
# Exception : le modèle stories260K (dérivé 512-vocab) et le tokenizer sont des
# données source bundlées pour l'auto-suffisance du dépôt (non régénérables
# in-tree). model_flash.bin reste ignoré (image flash regénérable par gen_flash_model).
!host/models/*.bin
*.config
*.rpt
*.log
*.ys.log
*.vvp
*.out
*.fsto
*.sim
results.xml

# ---- iverilog / cocotb build dirs (regenerable) ----
sim/sim_build/
sim/sim_build_v2/
build/sim_build/
**/sim_build/

# ---- Verilator build dir (regenerable : Vtop*.cpp/.obj, sim_top.exe, vpi_src) ----
# Investigation Verilator+cocotb embed (cf memoire verilator-setup-investigation).
# build_msvc.bat / patch_harness.py / run_verilator.bat sont des sources (racine sim/).
sim/obj_dir/

# ---- Verilator fast-sim build dir (regenerable : Vtop*.cpp/.obj, tb_verilator.exe) ----
# Flow Verilator untimed (cf sim/VERILATOR_FAST_SIM.md) : run_verilator_fb.ps1
# build dans sim/vobj/. Scripts .cpp/.ps1/.bat/.v/.md sont des sources (racine sim/).
sim/vobj/

# ---- dump copies utilisées par les sims (regenerables depuis host/) ----
# Les sims pointent sur les dumps host/ via DUMP=... ; ces copies sim/ sont des
# artefacts de run local (ex: gen_model_dump_hs16.json = copie du host/).
sim/gen_model_dump_hs16.json

# ---- JSON synth reports (regenerable) ----
# build/*.json sont des sorties nextpnr/yosys ; mais on ignore sélectivement :
build/*.json

# ---- generated test vectors ----
sim/sim_build_v2/*.vh

# ---- Python ----
__pycache__/
*.pyc
*.pyo
# ---- host generated oracle dumps (regenerable via prove_gen_node.py) ----
host/*.npz
.pytest_cache/
.mypy_cache/

# ---- editor / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
# ---- FPGA Packet Tracer (server/ + web/) ----
web/node_modules/
web/dist/
server/_work/
server/vcd/*.vcd
server/vcd/*.index.json
