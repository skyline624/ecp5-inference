# sdram_test.lpf -- Gate 2b: SDRAM self-test on Colorlight i9 v7.2.
# Only the SDRAM signals that reach FPGA pins on the i9 are listed here:
# CLK, nRAS, nCAS, nWE, BA[1:0], A[10:0], DQ[31:0]. CKE/CS/DQM are hardwired
# on the PCB (no FPGA pin) -- NOT in this LPF. Source: colorlight_i9_v7.2.md.

# --- Clock (25 MHz) ---
LOCATE COMP "clk25" SITE "P3";  IOBUF PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHZ;

# --- LED D2 ---
LOCATE COMP "led" SITE "L2";  IOBUF PORT "led" IO_TYPE=LVCMOS33;

# --- SDRAM control / CLK ---
LOCATE COMP "SDRAM_CLK"   SITE "B9";  IOBUF PORT "SDRAM_CLK"   IO_TYPE=LVCMOS33;
FREQUENCY PORT "SDRAM_CLK" 25 MHZ;
LOCATE COMP "SDRAM_nRAS"  SITE "B10"; IOBUF PORT "SDRAM_nRAS"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_nCAS"  SITE "A9";  IOBUF PORT "SDRAM_nCAS"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_nWE"   SITE "A10"; IOBUF PORT "SDRAM_nWE"   IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_BA[0]" SITE "B11"; IOBUF PORT "SDRAM_BA[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_BA[1]" SITE "C8";  IOBUF PORT "SDRAM_BA[1]" IO_TYPE=LVCMOS33;

# --- SDRAM A[10:0] (B13,C14,A16,A17,B16,B15,A14,A13,A12,A11,B12) ---
LOCATE COMP "SDRAM_A[0]"  SITE "B13"; IOBUF PORT "SDRAM_A[0]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[1]"  SITE "C14"; IOBUF PORT "SDRAM_A[1]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[2]"  SITE "A16"; IOBUF PORT "SDRAM_A[2]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[3]"  SITE "A17"; IOBUF PORT "SDRAM_A[3]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[4]"  SITE "B16"; IOBUF PORT "SDRAM_A[4]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[5]"  SITE "B15"; IOBUF PORT "SDRAM_A[5]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[6]"  SITE "A14"; IOBUF PORT "SDRAM_A[6]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[7]"  SITE "A13"; IOBUF PORT "SDRAM_A[7]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[8]"  SITE "A12"; IOBUF PORT "SDRAM_A[8]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[9]"  SITE "A11"; IOBUF PORT "SDRAM_A[9]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_A[10]" SITE "B12"; IOBUF PORT "SDRAM_A[10]" IO_TYPE=LVCMOS33;

# --- SDRAM DQ[31:0] ---
LOCATE COMP "SDRAM_DQ[0]"  SITE "B6";  IOBUF PORT "SDRAM_DQ[0]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[1]"  SITE "A5";  IOBUF PORT "SDRAM_DQ[1]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[2]"  SITE "A6";  IOBUF PORT "SDRAM_DQ[2]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[3]"  SITE "A7";  IOBUF PORT "SDRAM_DQ[3]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[4]"  SITE "C7";  IOBUF PORT "SDRAM_DQ[4]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[5]"  SITE "B8";  IOBUF PORT "SDRAM_DQ[5]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[6]"  SITE "B5";  IOBUF PORT "SDRAM_DQ[6]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[7]"  SITE "A8";  IOBUF PORT "SDRAM_DQ[7]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[8]"  SITE "D8";  IOBUF PORT "SDRAM_DQ[8]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[9]"  SITE "D7";  IOBUF PORT "SDRAM_DQ[9]"  IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[10]" SITE "E8";  IOBUF PORT "SDRAM_DQ[10]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[11]" SITE "D6";  IOBUF PORT "SDRAM_DQ[11]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[12]" SITE "C6";  IOBUF PORT "SDRAM_DQ[12]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[13]" SITE "D5";  IOBUF PORT "SDRAM_DQ[13]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[14]" SITE "E7";  IOBUF PORT "SDRAM_DQ[14]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[15]" SITE "C5";  IOBUF PORT "SDRAM_DQ[15]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[16]" SITE "C10"; IOBUF PORT "SDRAM_DQ[16]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[17]" SITE "D9";  IOBUF PORT "SDRAM_DQ[17]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[18]" SITE "E11"; IOBUF PORT "SDRAM_DQ[18]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[19]" SITE "D11"; IOBUF PORT "SDRAM_DQ[19]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[20]" SITE "C11"; IOBUF PORT "SDRAM_DQ[20]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[21]" SITE "D12"; IOBUF PORT "SDRAM_DQ[21]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[22]" SITE "E9";  IOBUF PORT "SDRAM_DQ[22]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[23]" SITE "C12"; IOBUF PORT "SDRAM_DQ[23]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[24]" SITE "E14"; IOBUF PORT "SDRAM_DQ[24]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[25]" SITE "C15"; IOBUF PORT "SDRAM_DQ[25]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[26]" SITE "E13"; IOBUF PORT "SDRAM_DQ[26]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[27]" SITE "D15"; IOBUF PORT "SDRAM_DQ[27]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[28]" SITE "E12"; IOBUF PORT "SDRAM_DQ[28]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[29]" SITE "B17"; IOBUF PORT "SDRAM_DQ[29]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[30]" SITE "D14"; IOBUF PORT "SDRAM_DQ[30]" IO_TYPE=LVCMOS33;
LOCATE COMP "SDRAM_DQ[31]" SITE "D13"; IOBUF PORT "SDRAM_DQ[31]" IO_TYPE=LVCMOS33;